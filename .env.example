# Episto — Environment Variables
# Copy this file to .env and fill in all required values.
# Never commit .env to version control.
# See docs/07-operations/deployment-and-ci.md §3 for the full reference.

# ── Server ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug
TRUST_PROXY=false

# ── Database (PostgreSQL) ──────────────────────────────────────────
DATABASE_URL=postgresql://episto:episto@localhost:5432/episto
# Production compose builds DATABASE_URL from these — set a strong password.
POSTGRES_USER=episto
POSTGRES_PASSWORD=episto
POSTGRES_DB=episto

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object Storage (S3-compatible / MinIO for local) ───────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=episto
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me
# Production compose uses these for MinIO container credentials.
MINIO_ROOT_USER=replace_me
MINIO_ROOT_PASSWORD=replace_me

# ── Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── Session ────────────────────────────────────────────────────────
SESSION_TTL_HOURS=72
RESUME_INACTIVITY_HOURS=48
ORDER_ACCESS_DAYS=90
ORDER_ACCESS_TOKEN_SECRET=replace_with_long_random_secret

# ── Retention ──────────────────────────────────────────────────────
CONTENT_RETENTION_DAYS=7
PDF_RETENTION_HOURS_POST_DISPATCH=24
METADATA_RETENTION_YEARS=7
STATEMENT_RETENTION_DAYS=10

# ── AI (Azure OpenAI / Azure AI Project agent) ───────────────────
AI_PROVIDER_MODE=azure_openai
AZURE_OPENAI_ENDPOINT=https://replace-me.openai.azure.com
AZURE_OPENAI_API_KEY=replace_me
AZURE_OPENAI_API_VERSION=2024-06-01
AI_DRAFT_MODEL=gpt-4.1
AI_CLASSIFY_MODEL=gpt-4.1-mini
AZURE_SPEECH_REGION=switzerlandnorth
AZURE_SPEECH_API_KEY=replace_me
AZURE_SPEECH_REQUEST_TIMEOUT_MS=15000
AZURE_SPEECH_CUSTOM_ENDPOINT_ID=
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_AGENT_NAME=
AZURE_AI_AGENT_VERSION=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────
# Temporary development values can use a fallback domain such as houle.ai.
# Replace APP_DISPLAY_NAME, EMAIL_FROM, and SUPPORT_EMAIL together once the
# final app name and domain are set.
RESEND_API_KEY=re_replace_me
APP_DISPLAY_NAME=Episto
EMAIL_FROM=contact@houle.ai
SUPPORT_EMAIL=contact@houle.ai
LEGAL_ENTITY_NAME=West Bay SA
LEGAL_ENTITY_ADDRESS_LINE_1=Chemin du Pre-Roset 19
LEGAL_ENTITY_ADDRESS_LINE_2=1294 Genthod
LEGAL_ENTITY_COUNTRY=Switzerland
LEGAL_ENTITY_UID_VAT=CHE-107.892.984
APP_PUBLIC_URL=http://localhost:5000

# ── SMS verification ──────────────────────────────────────────────
# Use noop locally unless you intentionally want to send fee-bearing SMS.
SMS_PROVIDER=noop
SMS_SENDER_ID=EPISTO
SMS_REQUEST_TIMEOUT_MS=8000
BUDGETSMS_API_BASE_URL=https://api.budgetsms.net/sendsms/
BUDGETSMS_USERNAME=
BUDGETSMS_USER_ID=
BUDGETSMS_HANDLE=

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5000

# Admin auth (Microsoft SSO — only signed session cookies are accepted)
# Use a dedicated WestBay admin app registration here. Do not copy the temporary AI
# `AZURE_*` tenant/client values into `ADMIN_MICROSOFT_*`.
ADMIN_SESSION_TTL_HOURS=12
ADMIN_SESSION_SECRET=replace_with_a_32_plus_character_random_secret
ADMIN_MICROSOFT_CLIENT_ID=replace_me
ADMIN_MICROSOFT_CLIENT_SECRET=replace_me
# Must be the actual WestBay tenant ID — never use "common"
ADMIN_MICROSOFT_TENANT_ID=replace_with_westbay_tenant_id
ADMIN_MICROSOFT_REDIRECT_URI=http://localhost:5000/api/v1/admin/auth/microsoft/callback
# Comma-separated client IPs allowed to access admin routes.
# Leave empty to disable IP allowlisting (all IPs allowed — SSO auth still required).
ADMIN_IP_ALLOWLIST=

# ── Pricing (provider quote + Episto markup, integer cents) ───
PRICE_STANDARD_MARKUP_CENTS=340
PRICE_REGISTERED_MARKUP_CENTS=340

# ── Puppeteer (PDF rendering) ────────────────────────────────────
# Path to Chromium binary. Default: /usr/bin/chromium-browser
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ── Postal dispatch (ePost / KLARA oneAPI) ────────────────────────
# Guardrail: keep this in mock until explicit production cutover.
# `live` is only valid when NODE_ENV=production and POSTAL_DISPATCH_PROVIDER=epost.
# Mock mode still returns provider-shaped references/tracking fields so UI, emails,
# and the confirmation-document PDF can be validated without fee-bearing submissions.
POSTAL_DISPATCH_PROVIDER=stub
EPOST_SUBMISSION_MODE=mock
EPOST_API_BASE_URL=https://api.epost.ch
EPOST_API_KEY=
EPOST_TIMEOUT_MS=20000
EPOST_STANDARD_POSTAGE=A_POST
EPOST_REGISTERED_POSTAGE=REGISTERED

# ── Zefix (company search proxy) ───────────────────────────────────
# Internal proxy service runs in docker compose and keeps credentials server-side.
COMPANY_SEARCH_PROVIDER=zefix
COMPANY_SEARCH_TIMEOUT_MS=8000
ZEFIX_PROXY_BASE_URL=http://zefix-proxy:8081
ADDRESS_SEARCH_PROVIDER=geo_admin
ADDRESS_SEARCH_TIMEOUT_MS=8000
# geo.admin.ch address autocomplete uses Swiss federal map/search data and does not require a secret.
GEO_ADMIN_API_BASE_URL=https://api3.geo.admin.ch
ADDRESS_VALIDATION_PROVIDER=none
# SWISS_POST_ADDRESS_API_BASE_URL=https://api.post.ch/...
# SWISS_POST_ADDRESS_API_SCOPE=digital-commerce-address
ZEFIX_USERNAME=replace_me
ZEFIX_PASSWORD=replace_me
ZEFIX_BASE_URL=https://www.zefix.admin.ch
ZEFIX_COMPANY_SEARCH_PATH=/ZefixPublicREST/api/v1/company/search
ZEFIX_COMPANY_SEARCH_METHOD=POST
ZEFIX_PROXY_PORT=8081

# ── Observability ─────────────────────────────────────────────────
# Sentry DSN for backend error tracking.
# SENTRY_DSN=https://replace_me@o0.ingest.sentry.io/0

# ── Frontend (build-time — copy to frontend/.env.local for dev) ───
# These are embedded at Next.js build time. Never put secrets here.
NEXT_PUBLIC_SITE_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=/api
# Stripe publishable key (pk_test_... for dev, pk_live_... for production).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# NEXT_PUBLIC_SENTRY_DSN=https://replace_me@o0.ingest.sentry.io/0
NEXT_PUBLIC_APP_ENV=development

# Production-only proxy routing overrides for docker-compose.prod.yml.
# Leave blank to derive the host and certificate directory from NEXT_PUBLIC_SITE_URL.
# PUBLIC_FRONTEND_SERVER_NAMES=episto.ch www.episto.ch
# PUBLIC_TLS_CERT_NAME=episto.ch
