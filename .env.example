# Swiss Mail — Environment Variables
# Copy this file to .env and fill in all required values.
# Never commit .env to version control.
# See docs/07-operations/deployment-and-ci.md §3 for the full reference.

# ── Server ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# ── Database (PostgreSQL) ──────────────────────────────────────────
DATABASE_URL=postgresql://swissmail:swissmail@localhost:5432/swissmail

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object Storage (S3-compatible / MinIO for local) ───────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=swiss-mail
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── Session ────────────────────────────────────────────────────────
SESSION_TTL_HOURS=72
RESUME_INACTIVITY_HOURS=48
ORDER_ACCESS_DAYS=90

# ── Retention ──────────────────────────────────────────────────────
CONTENT_RETENTION_DAYS=7
PDF_RETENTION_HOURS_POST_DISPATCH=24
METADATA_RETENTION_YEARS=7

# ── AI (Azure OpenAI) ─────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://replace-me.openai.azure.com
AZURE_OPENAI_API_KEY=replace_me
AZURE_OPENAI_API_VERSION=2024-06-01
AI_DRAFT_MODEL=gpt-4.1
AI_CLASSIFY_MODEL=gpt-4.1-mini

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=re_replace_me
EMAIL_FROM=noreply@swissmail.ch

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# Admin (HTTP Basic Auth over TLS)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-in-production

# ── Pricing (integer cents, CHF only) ──────────────────────────────
PRICE_STANDARD_CENTS=490
PRICE_REGISTERED_CENTS=890

# ── Puppeteer (PDF rendering) ────────────────────────────────────
# Path to Chromium binary. Default: /usr/bin/chromium-browser
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ── Swiss Post (postal dispatch — not yet active) ─────────────────
# Pending provider onboarding. See docs/08-guardrails/provider-readiness-gate.md
# SWISS_POST_API_BASE_URL=https://api.post.ch/...
# SWISS_POST_CLIENT_ID=replace_me
# SWISS_POST_CLIENT_SECRET=replace_me
# SWISS_POST_SCOPE=digital-commerce

# ── Observability ─────────────────────────────────────────────────
# Sentry DSN for backend error tracking.
# SENTRY_DSN=https://replace_me@o0.ingest.sentry.io/0

# ── Frontend (build-time — copy to frontend/.env.local for dev) ───
# These are embedded at Next.js build time. Never put secrets here.
NEXT_PUBLIC_API_URL=/api
# Stripe publishable key (pk_test_... for dev, pk_live_... for production).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# NEXT_PUBLIC_SENTRY_DSN=https://replace_me@o0.ingest.sentry.io/0
NEXT_PUBLIC_APP_ENV=development
