{
  "name": "@swiss-mail/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@fastify/cookie": "^10.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/csrf-protection": "^7.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@swiss-mail/shared": "*",
    "bullmq": "^5.0.0",
    "drizzle-orm": "^0.33.0",
    "drizzle-zod": "^0.5.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.0",
    "pg": "^8.20.0",
    "pino": "^9.0.0",
    "postgres": "^3.4.0",
    "resend": "^4.0.0",
    "stripe": "^16.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.24.0",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.0.0"
  }
