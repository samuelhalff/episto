{
  "name": "@swiss-mail/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "dispatch:refresh-rates": "tsx src/scripts/refresh-dispatch-rates.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "node dist/db/migrate.js",
    "db:migrate:dev": "drizzle-kit migrate",
    "db:test-latest-rollback": "tsx src/scripts/verify-latest-migration-rollback.ts",
    "db:studio": "drizzle-kit studio",
    "start:prod": "npm run db:migrate && node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@azure/ai-projects": "^2.0.1",
    "@azure/identity": "^4.13.1",
    "@fastify/cookie": "^10.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.2.0",
    "@swiss-mail/shared": "*",
    "bullmq": "^5.0.0",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.1",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.0",
    "jose": "^6.2.2",
    "microsoft-cognitiveservices-speech-sdk": "^1.49.0",
    "openai": "^6.32.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.0",
    "puppeteer": "^24.40.0",
    "puppeteer-core": "^24.40.0",
    "resend": "^4.0.0",
    "stripe": "^16.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.0.0"
  }
}
